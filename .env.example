# ─────────────────────────────────────────────────────────────
# NOVA PRIME SERVICES ApS — environment configuration
# Copy this file to `.env` and fill in the real values.
# NEVER commit the filled-in `.env` file.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, Open Graph.
PUBLIC_SITE_URL=https://novaprime.dk

# ── Contact form / e-mail delivery ───────────────────────────
# Recipient address(es) that receive new contact-form submissions.
# Separate multiple recipients with commas.
CONTACT_EMAIL=info@novaprimes.dk,mhajali@novaprimes.dk,aibrahim@novaprimes.dk,rferjani@novaprimes.dk

# SMTP transport. Configure to ENABLE real e-mail delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASSWORD=changeme

# "starttls" (port 587) | "none" (port 25) | "ssl" (port 465)
SMTP_SECURE=false

# Optional: verified sender address for the outbound e-mail.
SMTP_FROM=NOVA PRIME SERVICES <postmaster@example.com>

# ── Runtime toggles ───────────────────────────────────────────
# Set to "1" to force the contact form into a demonstration
# mode that explains e-mail is not yet configured. Leave "0"
# in production once SMTP is set up.
FORM_DEMO_MODE=0
